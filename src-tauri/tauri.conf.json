{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zscaler Okta Workspaces",
  "version": "0.1.0",
  "identifier": "com.example.zscaleroktaworkspaces",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Zscaler Okta Workspaces",
        "width": 1600,
        "height": 1000,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
